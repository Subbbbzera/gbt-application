# Налаштування порту сервера
PORT=5000

# Секретний ключ для підпису JWT токенів
JWT_SECRET=your_jwt_secret_key_here

# Налаштування бази даних MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=my_store

# Налаштування пошти (Gmail)
# EMAIL_USER - ваша пошта Gmail
# EMAIL_PASS - пароль додатка (16-значний код від Google)
# Отримайте його тут: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Налаштування Telegram сповіщень
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here
